public class Contact
{
    public int Id { get; set; }
    public string Name { get; set; }
    public string Phone { get; set; }
    public string Email { get; set; }
    public string Address { get; set; }
}

using System;
using System.Collections.Generic;
using System.Linq;

public class Agenda
{
    private List<Contact> contacts = new List<Contact>();
    private int nextId = 1;

    public void AddContact()
    {
        Console.Write("Nombre: ");
        string name = Console.ReadLine();

        Console.Write("Teléfono: ");
        string phone = Console.ReadLine();

        Console.Write("Email: ");
        string email = Console.ReadLine();

        Console.Write("Dirección: ");
        string address = Console.ReadLine();

        Contact newContact = new Contact
        {
            Id = nextId,
            Name = name,
            Phone = phone,
            Email = email,
            Address = address
        };

        contacts.Add(newContact);
        nextId++;

        Console.WriteLine("Contacto agregado correctamente.");
    }

    public void ViewContacts()
    {
        Console.WriteLine("\nID | Nombre | Teléfono | Email | Dirección");
        Console.WriteLine("--------------------------------------------------");

        foreach (var contact in contacts)
        {
            Console.WriteLine($"{contact.Id} | {contact.Name} | {contact.Phone} | {contact.Email} | {contact.Address}");
        }
    }

    public void DeleteContact()
    {
        Console.Write("Digite el ID a eliminar: ");
        int id = Convert.ToInt32(Console.ReadLine());

        var contact = contacts.FirstOrDefault(c => c.Id == id);

        if (contact != null)
        {
            contacts.Remove(contact);
            Console.WriteLine("Contacto eliminado.");
        }
        else
        {
            Console.WriteLine("ID no encontrado.");
        }
    }

    public void EditContact()
    {
        Console.Write("Digite el ID a modificar: ");
        int id = Convert.ToInt32(Console.ReadLine());

        var contact = contacts.FirstOrDefault(c => c.Id == id);

        if (contact != null)
        {
            Console.Write("Nuevo Nombre: ");
            contact.Name = Console.ReadLine();

            Console.Write("Nuevo Teléfono: ");
            contact.Phone = Console.ReadLine();

            Console.Write("Nuevo Email: ");
            contact.Email = Console.ReadLine();

            Console.Write("Nueva Dirección: ");
            contact.Address = Console.ReadLine();

            Console.WriteLine("Contacto actualizado.");
        }
        else
        {
            Console.WriteLine("ID no encontrado.");
        }
    }

    public void SearchContact()
    {
        Console.Write("Digite el nombre a buscar: ");
        string name = Console.ReadLine();

        var results = contacts
            .Where(c => c.Name.ToLower().Contains(name.ToLower()))
            .ToList();

        foreach (var contact in results)
        {
            Console.WriteLine($"{contact.Id} | {contact.Name} | {contact.Phone} | {contact.Email} | {contact.Address}");
        }

        if (results.Count == 0)
            Console.WriteLine("No se encontraron resultados.");
    }
}

class Program
{
    static void Main(string[] args)
    {
        Agenda agenda = new Agenda();

        bool running = true;

        while (running)
        {
            Console.WriteLine("\n1. Agregar");
            Console.WriteLine("2. Ver");
            Console.WriteLine("3. Buscar");
            Console.WriteLine("4. Editar");
            Console.WriteLine("5. Eliminar");
            Console.WriteLine("6. Salir");

            Console.Write("Opción: ");
            int option = Convert.ToInt32(Console.ReadLine());

            switch (option)
            {
                case 1: agenda.AddContact(); break;
                case 2: agenda.ViewContacts(); break;
                case 3: agenda.SearchContact(); break;
                case 4: agenda.EditContact(); break;
                case 5: agenda.DeleteContact(); break;
                case 6: running = false; break;
                default: Console.WriteLine("Opción inválida"); break;
            }
        }
    }
}
